<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NexStore — Sua loja online de hardware, periféricos e acessórios de tecnologia. Encontre os melhores preços!">
    <meta name="keywords" content="loja online, hardware, periféricos, tecnologia, computador, gamer, monitor">
    <meta property="og:title" content="NexStore — Loja de Tecnologia">
    <meta property="og:description" content="Os melhores preços em hardware, periféricos e acessórios.">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <title>NexStore — Sua Loja de Tecnologia</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/main.css">
</head>
<body x-data="nexstoreApp()" x-init="init()">

    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-3" role="navigation" aria-label="Menu principal da loja">
        <div class="container">
            <a class="navbar-brand fs-4" href="/" aria-label="NexStore — Página Inicial"><i class="fas fa-gamepad text-primary me-2" aria-hidden="true"></i>Nex<span class="text-primary">Store</span></a>
            
            <!-- Botão hambúrguer animado -->
            <button class="ns-navbar-toggler" type="button" onclick="toggleMobileMenu()" aria-controls="navLoja" aria-expanded="false" aria-label="Abrir menu de navegação">
                <div class="ns-hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </button>

            <div class="navbar-collapse" id="navLoja">
                <form class="d-flex mx-auto w-50 my-2 my-lg-0" action="/" method="GET" role="search">
                    <div class="input-group">
                        <input class="form-control border-0 shadow-none" type="search" name="busca" placeholder="O que você está procurando?" aria-label="Buscar produtos" value="<%= typeof termoBusca !== 'undefined' ? termoBusca : '' %>">
                        <button class="btn btn-primary px-4" type="submit" aria-label="Buscar"><i class="fas fa-search" aria-hidden="true"></i></button>
                    </div>
                </form>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center" role="menubar">
    
                    <% if (usuarioLogado) { %>
                        <li class="nav-item dropdown me-lg-3" role="none">
                            <a class="nav-link dropdown-toggle fw-bold text-white d-flex align-items-center" href="#" id="menuUsuario" role="menuitem" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="<%= usuarioLogado.url_foto %>" class="rounded-circle me-2 bg-white" style="width: 32px; height: 32px; object-fit: cover; padding: 2px;" alt="Foto de perfil de <%= usuarioLogado.nome %>"> 
                                Olá, <%= usuarioLogado.nome.split(' ')[0] %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" role="menu">
                                
                                <% if (usuarioLogado.is_admin) { %>
                                    <li role="none">
                                        <a class="dropdown-item fw-bold text-primary py-2" href="/admin/dashboard" role="menuitem">
                                            <i class="fas fa-shield-alt me-2" aria-hidden="true"></i> Painel de Administração
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                <% } %>
                                
                                <li role="none"><a class="dropdown-item py-2" href="/pedidos/meus-pedidos" role="menuitem"><i class="fas fa-box me-2" aria-hidden="true"></i> Meus Pedidos</a></li>
                                <li role="none"><a class="dropdown-item py-2" href="/perfil" role="menuitem"><i class="fas fa-cog me-2" aria-hidden="true"></i> Minha Conta</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li role="none"><a class="dropdown-item py-2 text-danger fw-bold" href="/logout" role="menuitem"><i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i> Sair da Conta</a></li>
                            </ul>
                        </li>
                        
                    <% } else { %>
                        <li class="nav-item me-lg-3" role="none">
                            <a class="nav-link fw-bold" href="/login" role="menuitem"><i class="fas fa-user-circle fs-5 me-1" aria-hidden="true"></i> Entrar / Cadastrar</a>
                        </li>
                    <% } %>

                    <li class="nav-item" role="none">
                        <a class="btn btn-outline-light position-relative rounded-pill px-3" href="/carrinho" role="menuitem" aria-label="Carrinho de compras">
                            <i class="fas fa-shopping-cart" aria-hidden="true"></i> Carrinho
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" aria-label="<%= typeof totalItensCarrinho !== 'undefined' ? totalItensCarrinho : '0' %> itens no carrinho" x-text="totalItens" x-show="totalItens > 0">
                                <%= typeof totalItensCarrinho !== 'undefined' ? totalItensCarrinho : '0' %>
                            </span>
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <main id="conteudo-principal" role="main">
        <%- body %>
    </main>

    <footer class="bg-dark text-white py-5 mt-5" role="contentinfo">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 mb-3">
                    <h5 class="footer-brand mb-3"><i class="fas fa-gamepad text-primary me-2" aria-hidden="true"></i>Nex<span class="text-primary">Store</span></h5>
                    <p class="text-white-50 small mb-0">Sua loja online de hardware, periféricos e acessórios de tecnologia.</p>
                </div>
                <div class="col-lg-4 mb-3">
                    <h6 class="fw-bold mb-3">Links Rápidos</h6>
                    <div class="footer-links d-flex flex-column gap-2">
                        <a href="/" class="small">Início</a>
                        <a href="/perfil" class="small">Minha Conta</a>
                        <a href="/pedidos/meus-pedidos" class="small">Meus Pedidos</a>
                        <a href="/carrinho" class="small">Carrinho</a>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <h6 class="fw-bold mb-3">Contato</h6>
                    <p class="text-white-50 small mb-1"><i class="fas fa-envelope me-2" aria-hidden="true"></i>contato@nexstore.com.br</p>
                    <p class="text-white-50 small mb-0"><i class="fas fa-phone me-2" aria-hidden="true"></i>(31) 99999-0000</p>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center">
                <p class="mb-0 text-white-50 small">&copy; 2026 NexStore. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
    <script>
        (function () {
            var toggler = document.querySelector('.ns-navbar-toggler');
            var nav = document.getElementById('navLoja');

            function toggleMobileMenu() {
                var isOpen = nav.classList.toggle('show');
                toggler.classList.toggle('active', isOpen);
                toggler.setAttribute('aria-expanded', isOpen);
            }

            window.toggleMobileMenu = toggleMobileMenu;

            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992) {
                    nav.classList.remove('show');
                    toggler.classList.remove('active');
                }
            });
        })();
    </script>
    <script>
        function nexstoreApp() {
            return {
                totalItens: parseInt('<%= typeof totalItensCarrinho !== "undefined" ? totalItensCarrinho : 0 %>') || 0,
                notificacao: null,
                notificacaoTipo: 'success',
                _notificacaoTimer: null,

                async init() {
                    await this.atualizarContadorCarrinho();
                },

                async atualizarContadorCarrinho() {
                    try {
                        const resp = await fetch('/api/carrinho');
                        const data = await resp.json();
                        if (data.sucesso) {
                            this.totalItens = data.totalItens;
                        }
                    } catch (e) {
                        // Silently fail — o fallback do EJS já cuida disso
                    }
                },

                async adicionarAoCarrinho(produtoId, quantidade = 1) {
                    try {
                        const resp = await fetch('/api/carrinho/adicionar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ produto_id: produtoId, quantidade })
                        });
                        const data = await resp.json();

                        if (data.sucesso) {
                            this.totalItens = data.totalItens;
                            this.mostrarNotificacao(data.mensagem, 'success');
                        } else {
                            this.mostrarNotificacao(data.mensagem, 'danger');
                        }
                    } catch (e) {
                        this.mostrarNotificacao('Erro ao adicionar ao carrinho.', 'danger');
                    }
                },

                async removerDoCarrinho(produtoId) {
                    try {
                        const resp = await fetch('/api/carrinho/remover/' + produtoId, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await resp.json();

                        if (data.sucesso) {
                            this.totalItens = data.totalItens;
                            this.mostrarNotificacao(data.mensagem, 'success');
                            return data;
                        }
                    } catch (e) {
                        this.mostrarNotificacao('Erro ao remover item.', 'danger');
                    }
                    return null;
                },

                mostrarNotificacao(mensagem, tipo = 'success') {
                    var self = this;
                    // Limpa timer anterior para evitar conflitos
                    if (self._notificacaoTimer) {
                        clearTimeout(self._notificacaoTimer);
                        self._notificacaoTimer = null;
                    }
                    self.notificacao = mensagem;
                    self.notificacaoTipo = tipo;
                    self._notificacaoTimer = setTimeout(function () {
                        self.notificacao = null;
                        self._notificacaoTimer = null;
                    }, 3000);
                },

                fecharNotificacao() {
                    if (this._notificacaoTimer) {
                        clearTimeout(this._notificacaoTimer);
                        this._notificacaoTimer = null;
                    }
                    this.notificacao = null;
                }
            };
        }
    </script>
    <!-- Toast Notificação Alpine.js -->
    <div x-cloak x-show.important="notificacao" x-transition:enter="ns-toast-enter" x-transition:enter-start="ns-toast-enter-start" x-transition:enter-end="ns-toast-enter-end" x-transition:leave="ns-toast-leave" x-transition:leave-start="ns-toast-leave-start" x-transition:leave-end="ns-toast-leave-end" :class="notificacaoTipo === 'success' ? 'ns-toast-success' : 'ns-toast-danger'" class="ns-toast position-fixed bottom-0 end-0 m-4 px-4 py-3 rounded-4 shadow-lg d-flex align-items-center gap-3" style="z-index: 9999; min-width: 300px;" role="alert" aria-live="polite">
        <i :class="notificacaoTipo === 'success' ? 'fas fa-check-circle text-success' : 'fas fa-exclamation-circle text-danger'" aria-hidden="true"></i>
        <span class="fw-bold small" x-text="notificacao"></span>
        <button type="button" class="btn-close btn-close-sm ms-2" @click="fecharNotificacao()" aria-label="Fechar"></button>
    </div>

    <!-- ═══ Chatbot IA ═══ -->
    <style>
        .chatbot-fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 10000;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
            color: #fff;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(13,110,253,0.4);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .chatbot-fab:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(13,110,253,0.5); }
        .chatbot-fab .badge-dot {
            position: absolute; top: 2px; right: 2px; width: 14px; height: 14px;
            background: #198754; border: 2px solid #fff; border-radius: 50%;
        }
        .chatbot-window {
            position: fixed;
            bottom: 96px;
            right: 24px;
            z-index: 10001;
            width: 380px;
            max-width: calc(100vw - 48px);
            height: 520px;
            max-height: calc(100vh - 160px);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 8px 40px rgba(0,0,0,0.18);
            background: #fff;
            animation: chatSlideUp 0.25s ease-out;
        }
        @keyframes chatSlideUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .chatbot-header {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            color: #fff;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .chatbot-header .d-flex { gap: 12px; align-items: center; }
        .chatbot-header .avatar {
            width: 40px; height: 40px; border-radius: 50%;
            background: rgba(255,255,255,0.2); display: flex;
            align-items: center; justify-content: center; font-size: 20px;
        }
        .chatbot-header small { opacity: 0.85; font-size: 11px; }
        .chatbot-messages {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #f8f9fa;
        }
        .chat-msg {
            max-width: 82%;
            padding: 10px 14px;
            border-radius: 14px;
            font-size: 14px;
            line-height: 1.45;
            word-wrap: break-word;
            animation: chatFadeIn 0.2s ease-out;
        }
        @keyframes chatFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        .chat-msg.bot {
            align-self: flex-start;
            background: #fff;
            color: #212529;
            border: 1px solid #dee2e6;
            border-bottom-left-radius: 4px;
        }
        .chat-msg.user {
            align-self: flex-end;
            background: #0d6efd;
            color: #fff;
            border-bottom-right-radius: 4px;
        }
        .chat-msg.typing span { display: inline-flex; gap: 4px; }
        .chat-msg.typing span i {
            width: 6px; height: 6px; background: #999; border-radius: 50%;
            animation: chatDot 1.2s infinite;
        }
        .chat-msg.typing span i:nth-child(2) { animation-delay: 0.2s; }
        .chat-msg.typing span i:nth-child(3) { animation-delay: 0.4s; }
        @keyframes chatDot {
            0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
            30% { opacity: 1; transform: translateY(-4px); }
        }
        .chatbot-input {
            padding: 12px 16px;
            border-top: 1px solid #dee2e6;
            display: flex;
            gap: 8px;
            background: #fff;
        }
        .chatbot-input input {
            flex: 1;
            border: 1px solid #dee2e6;
            border-radius: 24px;
            padding: 10px 16px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }
        .chatbot-input input:focus { border-color: #0d6efd; }
        .chatbot-input button {
            width: 42px; height: 42px;
            border-radius: 50%;
            border: none;
            background: #0d6efd;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }
        .chatbot-input button:hover { background: #0a58ca; }
        .chatbot-input button:disabled { background: #6c757d; cursor: not-allowed; }
        @media (max-width: 480px) {
            .chatbot-window { right: 8px; bottom: 80px; width: calc(100vw - 16px); height: calc(100vh - 120px); border-radius: 12px; }
            .chatbot-fab { bottom: 16px; right: 16px; }
        }
    </style>

    <button class="chatbot-fab" id="chatbotFab" onclick="toggleChatbot()" aria-label="Abrir chat de suporte">
        <i class="fas fa-comment-dots"></i>
        <span class="badge-dot" id="chatBadge"></span>
    </button>

    <div class="chatbot-window d-none" id="chatbotWindow">
        <div class="chatbot-header">
            <div class="d-flex">
                <div class="avatar"><i class="fas fa-robot"></i></div>
                <div>
                    <div class="fw-bold">NexBot</div>
                    <small>Assistente Virtual</small>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="toggleChatbot()" aria-label="Fechar chat">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="chatbot-messages" id="chatMessages">
            <div class="chat-msg bot">
                Olá! 👋 Sou o <strong>NexBot</strong>, assistente virtual da NexStore.<br><br>
                Posso ajudar com:<br>
                • Dúvidas sobre produtos<br>
                • Status de pedidos<br>
                • Entregas e trocas<br><br>
                Como posso te ajudar?
            </div>
        </div>
        <form class="chatbot-input" id="chatForm" onsubmit="enviarMensagemChat(event)">
            <input type="text" id="chatInput" placeholder="Digite sua mensagem..." autocomplete="off" maxlength="500">
            <button type="submit" id="chatSend" aria-label="Enviar mensagem">
                <i class="fas fa-paper-plane"></i>
            </button>
        </form>
    </div>

    <script>
    (function() {
        let chatAberto = false;
        let historico = [];
        let typingAdicionado = false;

        window.toggleChatbot = function() {
            chatAberto = !chatAberto;
            const win = document.getElementById('chatbotWindow');
            const fab = document.getElementById('chatbotFab');
            const badge = document.getElementById('chatBadge');

            if (chatAberto) {
                win.classList.remove('d-none');
                fab.innerHTML = '<i class="fas fa-times"></i>';
                badge.style.display = 'none';
                document.getElementById('chatInput').focus();
            } else {
                win.classList.add('d-none');
                fab.innerHTML = '<i class="fas fa-comment-dots"></i><span class="badge-dot" id="chatBadge"></span>';
            }
        };

        window.enviarMensagemChat = async function(e) {
            e.preventDefault();
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;

            const messagesDiv = document.getElementById('chatMessages');
            const btnSend = document.getElementById('chatSend');

            // Adiciona mensagem do usuário
            adicionarMensagem(msg, 'user');
            historico.push({ role: 'user', content: msg });
            input.value = '';

            // Mostra "digitando..."
            mostrarTyping();
            btnSend.disabled = true;

            try {
                const resp = await fetch('/api/ia/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        mensagem: msg,
                        historico: historico.slice(-10)
                    })
                });
                const data = await resp.json();

                removerTyping();

                if (data.sucesso) {
                    adicionarMensagem(data.resposta, 'bot');
                    historico.push({ role: 'assistant', content: data.resposta });
                } else {
                    adicionarMensagem(data.mensagem || 'Desculpe, tive um problema. Tente novamente.', 'bot');
                }
            } catch (err) {
                removerTyping();
                adicionarMensagem('Erro de conexão. Verifique sua internet.', 'bot');
            } finally {
                btnSend.disabled = false;
                input.focus();
            }
        };

        function adicionarMensagem(texto, tipo) {
            const div = document.getElementById('chatMessages');
            const msg = document.createElement('div');
            msg.className = 'chat-msg ' + tipo;
            msg.textContent = texto;
            div.appendChild(msg);
            div.scrollTop = div.scrollHeight;
        }

        function mostrarTyping() {
            if (typingAdicionado) return;
            typingAdicionado = true;
            const div = document.getElementById('chatMessages');
            const msg = document.createElement('div');
            msg.className = 'chat-msg bot typing';
            msg.id = 'typingIndicator';
            msg.innerHTML = '<span><i></i><i></i><i></i></span>';
            div.appendChild(msg);
            div.scrollTop = div.scrollHeight;
        }

        function removerTyping() {
            typingAdicionado = false;
            const el = document.getElementById('typingIndicator');
            if (el) el.remove();
        }
    })();
    </script>

</body>
</html>
