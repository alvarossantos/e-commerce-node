<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h1 class="fw-bold mb-4 h3">
                    <%= produto ? 'Editar Produto' : 'Cadastrar Novo Produto' %>
                </h1>
                
                <form action="<%= produto ? '/admin/produtos/' + produto.id + '?_method=PUT' : '/admin/produtos' %>" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="produto-nome" class="form-label small fw-bold text-muted">Nome do Produto</label>
                            <input type="text" id="produto-nome" name="nome" class="form-control" value="<%= produto ? produto.nome : '' %>" required>
                        </div>

                        <div class="col-md-3">
                            <label for="produto-preco" class="form-label small fw-bold text-muted">Preço (R$)</label>
                            <input type="number" step="0.01" id="produto-preco" name="preco" class="form-control" value="<%= produto ? parseFloat(produto.preco).toFixed(2) : '' %>" required inputmode="decimal">
                        </div>

                        <div class="col-md-3">
                            <label for="produto-quantidade" class="form-label small fw-bold text-muted">Estoque Atual</label>
                            <input type="number" step="1" min="0" id="produto-quantidade" name="quantidade" class="form-control" value="<%= typeof quantidade_estoque !== 'undefined' ? quantidade_estoque : '0' %>" required inputmode="numeric">
                        </div>
                        <div class="col-md-6">
                            <label for="produto-categoria" class="form-label small fw-bold text-muted">Categoria</label>
                            <select id="produto-categoria" name="categoria" class="form-select">
                                <option value="Hardware" <%= produto && produto.categoria === 'Hardware' ? 'selected' : '' %>>Hardware</option>
                                <option value="Periféricos" <%= produto && produto.categoria === 'Periféricos' ? 'selected' : '' %>>Periféricos</option>
                                <option value="Portáteis" <%= produto && produto.categoria === 'Portáteis' ? 'selected' : '' %>>Portáteis</option>
                                <option value="Gamer" <%= produto && produto.categoria === 'Gamer' ? 'selected' : '' %>>Gamer</option>
                                <option value="Monitores" <%= produto && produto.categoria === 'Monitores' ? 'selected' : '' %>>Monitores</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="produto-sku" class="form-label small fw-bold text-muted">SKU / Modelo</label>
                            <input type="text" id="produto-sku" name="sku" class="form-control" value="<%= produto ? produto.sku : '' %>" required>
                        </div>
                        <div class="col-md-6">
                            <label for="produto-url" class="form-label small fw-bold">URL da Imagem (Link Externo)</label>
                            <input type="url" id="produto-url" name="url_imagem" class="form-control" value="<%= produto ? produto.url_imagem : '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="produto-foto" class="form-label small fw-bold">Ou carregar do computador</label>
                            <input type="file" id="produto-foto" name="foto_local" class="form-control" accept="image/*">
                        </div>
                        <div class="col-12">
                            <label for="produto-descricao" class="form-label small fw-bold text-muted">Descrição Completa</label>
                            <div class="input-group">
                                <textarea id="produto-descricao" name="descricao" class="form-control" rows="4" required><%= produto ? produto.descricao : '' %></textarea>
                                <button type="button" id="btn-gerar-descricao" class="btn btn-outline-primary fw-bold" title="Gerar descrição com IA" onclick="gerarDescricaoIA()">
                                    <i class="fas fa-magic me-1" aria-hidden="true"></i> Gerar com IA
                                </button>
                            </div>
                            <div id="ia-status" class="form-text text-muted d-none mt-1">
                                <i class="fas fa-spinner fa-spin me-1" aria-hidden="true"></i> <span id="ia-status-texto">Gerando descrição...</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="produto-ean" class="form-label small fw-bold text-muted">Código de Barras (EAN)</label>
                            <input type="text" id="produto-ean" name="codigo_barras" class="form-control" value="<%= produto ? produto.codigo_barras : '' %>" inputmode="numeric">
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                            <%= produto ? 'Salvar Alterações' : 'Cadastrar Produto' %>
                        </button>
                        <a href="/admin/produtos" class="btn btn-light btn-lg rounded-pill px-4">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
async function gerarDescricaoIA() {
    const nome = document.getElementById('produto-nome').value.trim();
    const categoria = document.getElementById('produto-categoria').value;
    const preco = document.getElementById('produto-preco').value;
    const textarea = document.getElementById('produto-descricao');
    const btn = document.getElementById('btn-gerar-descricao');
    const status = document.getElementById('ia-status');
    const statusTexto = document.getElementById('ia-status-texto');

    if (!nome) {
        alert('Preencha o nome do produto antes de gerar a descrição.');
        return;
    }

    // UI: estado carregando
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Gerando...';
    status.classList.remove('d-none');
    statusTexto.textContent = 'A IA está analisando o produto...';

    try {
        const resp = await fetch('/api/ia/descricao', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nome, categoria, preco })
        });

        const data = await resp.json();

        if (data.sucesso) {
            textarea.value = data.descricao;
            statusTexto.textContent = 'Descrição gerada com sucesso!';
            status.classList.remove('text-danger');
            status.classList.add('text-success');
            setTimeout(() => {
                status.classList.add('d-none');
                status.classList.remove('text-success');
            }, 3000);
        } else {
            statusTexto.textContent = 'Erro: ' + data.mensagem;
            status.classList.add('text-danger');
        }
    } catch (e) {
        statusTexto.textContent = 'Erro de conexão. Verifique sua internet.';
        status.classList.add('text-danger');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-magic me-1"></i> Gerar com IA';
    }
}
</script>
