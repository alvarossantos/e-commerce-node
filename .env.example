PORT=3000
DB_HOST=localhost
DB_USER=seu_usuario_postgres
DB_PASS=sua_senha_postgres
DB_NAME=ecommerce_db
DB_PORT=5432
JWT_SECRET=sua_chave_secreta_super_segura
CSRF_SECRET=outra_chave_aleatoria_diferente_do_jwt

# ── IA — Provedor ativo ──────────────────────────
# Opções: openai | gemini | openrouter
AI_PROVIDER=openai

# ── IA — Modelo (opcional, sobrescreve o padrão do provedor) ──
# OpenAI:       gpt-4o-mini (padrão)
# Gemini:       gemini-2.0-flash (padrão)
# OpenRouter:   inclusionai/ling-3.0-flash:free (padrão)
# AI_MODEL=gpt-4o-mini

# ── IA — Chaves de API (configure apenas o provedor ativo) ──

# OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=
